,[16.33582927,48.21631338],[16.33600082,48.21618377],[16.33620377,48.21605266],[16.33643416,48.21592265],[16.33668749,48.21579624],[16.33695885,48.2156759],[16.33724294,48.21556397],[16.33753426,48.21546262],[16.3378271,48.21537384],[16.33811579,48.21529936],[16.33839471,48.21524061],[16.33865843,48.21519874],[16.33890179,48.21517458],[16.33912008,48.21516857],[16.33930905,48.21518086],[16.33946502,48.2152112],[16.33958496,48.215259],[16.33966651,48.21532331]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":410059,"BEREICH":"Gräberfeld","MO_CODE":"G3","INFO":"Außerhalb der Siedlungsbereiche legten die Römer - meist entlang der Ausfallstraßen - ihre Grabstätten an. Dies geschah zunächst in Form von Brandbestattungen, die oft durch Grabstelen oder bei vermögenden Bürgern durch große Grabbauten gekennzeichnet wurden. Ab dem 3. Jahrhundert nach Christus werden die Brandbestattungen durch Körperbestattungen abgelöst, wobei die Toten neben einfachen Grablegungen in Sarkophagen, Ziegelplatten- oder Steinkistengräbern beerdigt wurden. Die ungefähre Ausdehnung der Gräberfelder wird durch die Schraffuren angegeben.\r\n","SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410060","geometry":{"type":"Polygon","coordinates":[[[16.33909398,48.16149289],[16.33816812,48.16109211],[16.33741925,48.16040894],[16.33724224,48.15941603],[16.33782765,48.15856888],[16.33944777,48.15834111],[16.34106793,48.158587],[16.3428243,48.15918812],[16.34387279,48.16020828],[16.34425417,48.16120115],[16.34398193,48.16166574],[16.34300166,48.16192086],[16.34139503,48.16201203],[16.34011515,48.16182079],[16.33909398,48.16149289]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":410060,"BEREICH":"Gräberfeld","MO_CODE":null,"INFO":null,"SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410055","geometry":{"type":"Polygon","coordinates":[[[16.41994778,48.13052903],[16.42127485,48.13049313],[16.42237987,48.13058161],[16.42189765,48.1320623],[16.42113885,48.13237097],[16.41960312,48.13242642],[16.4189408,48.13140656],[16.41994778,48.13052903]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":410055,"BEREICH":"Streusiedlung","MO_CODE":"UL","INFO":"Im Umland von Vindobona ist mit verschiedenen kleinen Siedlungen und Gutshöfen zu rechnen, die die Versorgung der Stadt und des Militärs sicherstellten. In Unterlaa wurde ein Teil einer Siedlung ergraben, die vom Ende des 1. Jh. bis in die 2 Hälfte des 4. Jh. bestanden hat. In der frühen Phase entstanden Pfostenbauten, Grubenhäuser und Zäune. Ab Ende des 2. Jh. oder Anfang des 3. Jh. wurde mit dem Bau von Steingebäuden und Begrenzungsmauern begonnen. Die Verbauungsstruktur ist locker, es gibt drei bis vier gleichwertige Gebäude, mehrere Nebengebäude und Mauerzüge, die Hofareale abgrenzen. Der Gesamtbefund ist wohl als eine Art Streusiedlung anzusprechen.","SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410063","geometry":{"type":"Polygon","coordinates":[[[16.36739439,48.20519702],[16.36715426,48.20484378],[16.36756862,48.20402794],[16.3681567,48.20368097],[16.36985349,48.20341211],[16.3705438,48.20271271],[16.37125844,48.20316095],[16.37154077,48.20366584],[16.3712673,48.20435911],[16.36739439,48.20519702]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":410063,"BEREICH":"Gräberfeld","MO_CODE":"G5","INFO":"Außerhalb der Siedlungsbereiche legten die Römer - meist entlang der Ausfallstraßen - ihre Grabstätten an. Dies geschah zunächst in Form von Brandbestattungen, die oft durch Grabstelen oder bei vermögenden Bürgern durch große Grabbauten gekennzeichnet wurden. Ab dem 3. Jahrhundert nach Christus werden die Brandbestattungen durch Körperbestattungen abgelöst, wobei die Toten neben einfachen Grablegungen in Sarkophagen, Ziegelplatten- oder Steinkistengräbern beerdigt wurden. Die ungefähre Ausdehnung der Gräberfelder wird durch die Schraffuren angegeben. ","SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410064","geometry":{"type":"Polygon","coordinates":[[[1