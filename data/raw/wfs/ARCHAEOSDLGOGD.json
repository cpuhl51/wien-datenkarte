,[16.3804016,48.20915823],[16.38025927,48.20938943],[16.38017798,48.20956169],[16.38011025,48.20971582],[16.38011028,48.21007268],[16.37981096,48.21027534],[16.37955608,48.21033343],[16.37912402,48.21028931],[16.37881159,48.21022646]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":411313,"BEREICH":"Gräberfeld","MO_CODE":"G2","INFO":"Außerhalb der Siedlungsbereiche legten die Römer - meist entlang der Ausfallstraßen - ihre Grabstätten an. Dies geschah zunächst in Form von Brandbestattungen, die oft durch Grabstelen oder bei vermögenden Bürgern durch große Grabbauten gekennzeichnet wurden. Ab dem 3. Jahrhundert nach Christus werden die Brandbestattungen durch Körperbestattungen abgelöst, wobei die Toten neben einfachen Grablegungen in Sarkophagen, Ziegelplatten- oder Steinkistengräbern beerdigt wurden. Die ungefähre Ausdehnung der Gräberfelder wird durch die Schraffuren angegeben. ","SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410061","geometry":{"type":"Polygon","coordinates":[[[16.33645063,48.15622528],[16.33598055,48.15664465],[16.33551046,48.15701161],[16.33494242,48.15707714],[16.33411978,48.15691986],[16.33319229,48.15656789],[16.33232624,48.15596077],[16.33179014,48.15549163],[16.33113033,48.1549121],[16.33075922,48.15433259],[16.33075926,48.15397385],[16.33104798,48.15353235],[16.33141917,48.153284],[16.33228524,48.1528977],[16.33306879,48.15267697],[16.33422349,48.15256661],[16.33529571,48.1527046],[16.33620298,48.15292537],[16.33729279,48.15315857],[16.33762575,48.15343379],[16.3377041,48.15389249],[16.33750827,48.15450845],[16.33723407,48.15522926],[16.33690112,48.15575348],[16.33645063,48.15622528]]]},"geometry_name":"SHAPE","properties":{"OBJECTID":410061,"BEREICH":"Straßenstation","MO_CODE":"IN","INFO":"Straßensiedlungen sind kleine Weiler, die sich entlang der großen Ausfallsstraßen von Städten gebildet haben. In Inzersdorf, an der Straße von Vindobona gegen Süden nach Scarbantia, wurden die Überreste zweier Wohnhäuser und einiger Bestattungen entdeckt, die wohl Teil einer solchen Siedlung waren. Möglicher Weise lebten hier Legionsveteranen, die nach dem Ausscheiden aus der Armee dieser noch weitere fünf Jahre angehörten, aber als Abfindung ein Stück Land erhielten.","SE_ANNO_CAD_DATA":null}},{"type":"Feature","id":"ARCHAEOSDLGOGD.410062","geometry":{"type":"Polygon","coordinates":[[[16.39579992,48.18148642],[16.39574314,48.18148569],[16.39568645,48.18148345],[16.39562993,48.18147969],[16.39556738,48.18147374],[16.39550527,48.18146594],[16.39544375,48.18145631],[16.39538098,48.18144445],[16.39531908,48.18143068],[16.39525819,48.18141503],[16.39520611,48.1813999],[16.39515498,48.1813834],[16.39510488,48.18136554],[16.39502379,48.18133281],[16.39494613,48.18129655],[16.39487225,48.18125691],[16.39482778,48.18123028],[16.39478503,48.18120242],[16.39474406,48.18117339],[16.39469333,48.18113376],[16.39464593,48.18109234],[16.39460199,48.18104924],[16.39456041,48.18100312],[16.39452279,48.1809555],[16.39448926,48.18090653],[16.39446072,48.18085783],[16.39443621,48.18080815],[16.39441583,48.18075765],[16.39439413,48.18068499],[16.39438095,48.18061143],[16.39437637,48.1805374],[16.39437637,48.18053583],[16.3943805,48.18046265],[16.39439304,48.18038989],[16.39441391,48.18031799],[16.3944502,48.18023261],[16.39449823,48.18014986],[16.39455758,48.18007047],[16.39463257,48.17999046],[16.39471904,48.17991583],[16.39481615,48.17984729],[16.39489856,48.17979857],[16.39498636,48.17975424],[16.39507901,48.17971459],[16.39517597,48.17967984],[16.39530262,48.17964355],[16.39543393,48.17961562],[16.39556867,48.17959633],[16.39568584,48.1795868],[16.39580378,48.1795838],[16.39592169,48.17958735],[16.39595349,48.17958943],[16.3959852,48.17959199],[16.39601683,48.17959503],[16.39613274,48.17961038],[16.39624636,48.1796321],[16.39635688,48.17966006],[16.39646356,48.17969406],[16.39655178,48.179728],[16.39663615,48.17976608],[16.39671624,48.17980809],[16.39680507,48.17986271],[16.39688666,48.17992217],[16.39696042,